# Optional: aktiviert die KI-Belegerkennung (Claude). Ohne Schlüssel wird
# die Texterkennung lokal im Browser (Tesseract.js) verwendet.
ANTHROPIC_API_KEY=
# Port des Node-Servers (API + ausgelieferte App)
PORT=8787
# Ordner für die gespeicherten Rechnungen (bills.json)
DATA_DIR=data
# Hinter einem Reverse-Proxy (Render, Fly, nginx): Client-Adresse aus X-Forwarded-For lesen
TRUST_PROXY=0
# Limits: Belegfotos pro Gerät/Stunde, Belegfotos insgesamt pro Tag, neue Rechnungen pro Gerät/Stunde
RECEIPT_LIMIT_PER_HOUR=10
RECEIPT_LIMIT_PER_DAY=300
BILL_LIMIT_PER_HOUR=30
# Push-Benachrichtigungen: ohne Angabe erzeugt der Server die Schlüssel einmal und legt sie in DATA_DIR ab
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:du@beispiel.de
